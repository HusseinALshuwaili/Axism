# Axism — environment
# Copy to .env and fill in. NEVER commit .env.

PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- LLM providers (at least one). Defaults route through Groq. ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
ZHIPU_API_KEY=

# Role routing (optional; unset = Groq defaults)
LLM_FAST_PROVIDER=groq
LLM_FAST_MODEL=llama-3.1-8b-instant
LLM_DEEP_PROVIDER=openrouter
LLM_DEEP_MODEL=moonshotai/kimi-k2
LLM_FALLBACK_PROVIDER=groq

# --- Sandbox execution (E2B microVM). Without it, the shell runs in DRY-RUN. ---
E2B_API_KEY=
